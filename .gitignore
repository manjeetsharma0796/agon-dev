node_modules/
dist/
.next/
.turbo/
*.tsbuildinfo

# Secrets. .env.example is the only one that is committed.
.env
.env.*
!.env.example

# Keypairs never live in the repo. Devnet keys are repo-ignored files or CI secrets; mainnet keys
# live on team hardware or in a password manager; user agent keys live in the OS keychain.
*keypair*.json
id_*.json

# Spike output is committed on purpose (result.json), but raw dumps are not.
spikes/**/raw/
coverage/

# Next build output.
.next/
next-env.d.ts

# Surfpool writes a run log per simnet start, next to wherever it was invoked.
.surfpool/

# Agent worktrees. TASKS.md section 3 tells contributors to use git worktrees, and an agent
# creates them here, so they must not be committable, formatted or scanned. Never ignore all of
# .claude: the skills and settings under it are checked in on purpose.
.claude/worktrees/
