# Every variable, with its source. .env is gitignored. A secret scan runs on every push.
# Each environment gets its own keys, so a leaked dev key never touches production.
# Getting a key is a human task, tracked outside this repo.

# Helius: RPC, enhanced transactions, history. Free tier for local dev, a separate key for
# nightly CI spikes, a paid plan for the hosted app.
HELIUS_API_KEY=
# Verifying Helius webhook calls (F10, fall only).
HELIUS_WEBHOOK_SECRET=

# Jupiter Portal: higher rate limits for quotes and Trigger orders. The public quote and price
# API needs no key at low volume.
JUPITER_API_KEY=

# Cloudflare Workers AI, scoped to Workers AI only: Jev. The hosted app proxies /jev, so users
# need no key of their own.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# The pinned chat model behind the LLM-guard arm of benchmark B, and the benchmark agent.
# Local dev and nightly CI only, never hosted.
LLM_BASELINE_API_KEY=

# RugCheck: optional enrichment only, never on the path that decides a trade.
RUGCHECK_TOKEN=

# Neon Postgres: report cache, beta metrics, "is this rule right" answers.
DATABASE_URL=

# No key needed: Jupiter public quote and price API at low volume, Pyth Hermes, Swig (users pay
# their own fees; we do not use Swig's paymaster).
#
# Set in CI secrets only, never here: NPM_TOKEN (publish-only), PUBLIC_REPO_TOKEN (contents
# write on the public repo only), DEVNET_KEYPAIR (throwaway devnet key for the F5 spike).
# No mainnet signing key goes into CI, a .env file or the hosted app, ever.
