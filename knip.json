{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "ignoreBinaries": ["benchmark:b"],
  "ignoreDependencies": ["claude-code"],
  "workspaces": {
    ".": {
      "entry": ["scripts/*.mjs"],
      "project": ["scripts/**/*.mjs"]
    },
    "apps/*": {
      "entry": ["src/index.ts"],
      "project": ["src/**/*.ts"]
    },
    "apps/web": {
      "entry": ["src/index.ts", "app/**/*.{ts,tsx}"],
      "project": ["src/**/*.ts", "app/**/*.{ts,tsx}"]
    },
    "packages/*": {
      "entry": ["src/index.ts"],
      "project": ["src/**/*.ts"]
    },
    "packages/mcp": {
      "entry": ["src/index.ts", "src/serve.ts"],
      "project": ["src/**/*.ts"]
    }
  }
}
